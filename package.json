{
  "name": "swiggy-clone-mern",
  "version": "2.0.0",
  "description": "Full Stack MERN (MongoDB, Express, React, Node) Swiggy Clone Application",
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm start --prefix backend",
    "seed": "npm run seed --prefix backend",
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend",
    "install-all": "npm run install:backend && npm run install:frontend"
  },
  "keywords": [
    "mern",
    "swiggy",
    "mongodb",
    "express",
    "react",
    "nodejs",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
